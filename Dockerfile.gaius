# Runs the upstream Gaius RelayNode. It is server-side only;
# nothing is installed or executed on the Chromebook.
# v0.3.2 is the tested release currently hosted on Gaius GitHub Pages.
FROM alpine/git:2.47.2 AS source
RUN git clone --depth 1 --branch v0.3.2 https://github.com/TypeThe0ry/Gaius.git /src

FROM node:24-alpine
WORKDIR /app
COPY --from=source /src/apps/bridge/package.json /src/apps/bridge/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=source /src/apps/bridge/dist ./dist
# Permit only the exact Lunar Hosted World hostname with an underscore.
# Keep the upstream DNS validator unchanged for every other destination.
RUN node -e 'const fs=require("node:fs");const p="dist/policy.js";let s=fs.readFileSync(p,"utf8");const a="if (host.length === 0 || (isIP(host) === 0 && !isValidDnsName(host))) {";const b="if (host.length === 0 || (host !== \"chillice_.lunarclient.world\" && isIP(host) === 0 && !isValidDnsName(host))) {";if(!s.includes(a))throw Error("Upstream policy changed; refusing unsafe patch");fs.writeFileSync(p,s.replace(a,b));'
ENV NODE_ENV=production
ENV GAIUS_BRIDGE_HOST=0.0.0.0
ENV GAIUS_BRIDGE_PORT=10000
EXPOSE 10000
CMD ["node", "dist/main.js"]
